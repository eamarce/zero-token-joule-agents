<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form"
>
	<form:SimpleForm core:require="{ fmt: 'zt/playbooks/ext/formatter' }" editable="false" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
		<Label text="{i18n>backtestVerdict}" />
		<ObjectStatus
			text="{ path: 'backtest_json', formatter: 'fmt.verdict' }"
			state="{ path: 'backtest_json', formatter: 'fmt.verdictState' }"
			inverted="true"
		/>
		<Label text="{i18n>backtestReasons}" />
		<Text
			text="{ path: 'backtest_json', formatter: 'fmt.reasons' }"
		/>
		<Label text="{i18n>backtestMismatches}" />
		<Text
			text="{ path: 'backtest_json', formatter: 'fmt.mismatches' }"
			class="ztPlaybooksMono"
		/>
	</form:SimpleForm>
</core:FragmentDefinition>
