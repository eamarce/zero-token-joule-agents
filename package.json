{
  "name": "zero-token-joule-agents",
  "version": "0.2.0",
  "description": "A small SAP CAP + LangGraph.js agent that explores first, proposes a playbook a person signs, then runs repeat cases without a model, and measures its Type 1 : 2 : 3 ratio. Callable from SAP Joule over A2A.",
  "type": "module",
  "license": "MIT",
  "author": "Edgar Martinez",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test \"test/*.test.js\"",
    "ctl": "node scripts/ctl.js",
    "build": "cds build --production"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/openai": "^1.6.2",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.1.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "Approver",
                "AgentCaller"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": []
            },
            "joule": {
              "password": "joule",
              "roles": [
                "AgentCaller"
              ]
            }
          }
        },
        "[test]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "Approver",
                "AgentCaller"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": []
            },
            "joule": {
              "password": "joule",
              "roles": [
                "AgentCaller"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    },
    "features": {
      "in_memory_db": true
    },
    "server": {
      "body_parser": {
        "limit": "20mb"
      }
    }
  }
}
